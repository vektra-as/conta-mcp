# Mal for nøkkelfila ~/.config/conta-mcp/.env (chmod 600), som serveren leser selv.
# Kopier den også til .env i repoet hvis du kjører smoke-skriptene. .env er gitignorert og skal ALDRI committes.

# Påkrevd: API-nøkkel fra Conta (sendes som `apiKey`-header på hver request).
# Lag den i Conta under Bruker -> Data og tilgang -> Opprett ny API-nøkkel.
CONTA_API_KEY=

# Valgfri: default-organisasjon. Finn id-en med list_organizations / npm run smoke.
CONTA_ORG_ID=

# Valgfri: override av base-URL (default https://api.gateway.conta.no).
# Sandkasse for testing: https://api.gateway.conta-sandbox.no
# Må være https:// (http er bare lov mot localhost).
CONTA_BASE_URL=

# Valgfri: NO (default) eller EN — settes som `conta-language`-header.
CONTA_LANGUAGE=

# Valgfri: default true = bare lese-verktøy. Sett false for å slå på skrive-verktøyene.
# Andre verdier enn true/false/1/0/yes/no/ja/nei stopper serveren.
CONTA_READ_ONLY=

# Valgfri: true = registrer delete_payment og tillat removePaymentsIfExist på kreditnota
# (kan ikke angres). Default av.
CONTA_ALLOW_DELETE=

# Valgfri: timeout per request i millisekunder. Default 30000.
CONTA_TIMEOUT_MS=

# Valgfri: maks antall tegn i ett verktøysvar før det avkortes. Default 100000.
CONTA_MAX_RESPONSE_CHARS=
